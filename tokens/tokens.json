{
  "primitive": {
    "color": {
      "black": {
        "$type": "color",
        "$value": "oklch(0 0 0)"
      },
      "night": {
        "$type": "color",
        "$value": "oklch(0.19 0.025 230)"
      },
      "ink": {
        "$type": "color",
        "$value": "oklch(0.2099 0.0341 263.44)"
      },
      "moss": {
        "$type": "color",
        "$value": "oklch(0.5799 0.1448 153.76)"
      },
      "white": {
        "$type": "color",
        "$value": "oklch(1 0 0)"
      }
    },
    "font": {
      "mono": {
        "$type": "fontFamilies",
        "$value": "var(--font-mono, ui-monospace), monospace"
      },
      "sans": {
        "$type": "fontFamilies",
        "$value": "var(--font-sans, system-ui), sans-serif"
      }
    },
    "grid": {
      "goldenRatio": {
        "$type": "number",
        "$value": 1.618
      },
      "module": {
        "$type": "dimension",
        "$value": "0.25rem"
      }
    },
    "viewport": {
      "phone-small": {
        "width": {
          "$type": "dimension",
          "$value": "320px"
        },
        "height": {
          "$type": "dimension",
          "$value": "568px"
        }
      },
      "phone": {
        "width": {
          "$type": "dimension",
          "$value": "390px"
        },
        "height": {
          "$type": "dimension",
          "$value": "844px"
        }
      },
      "tablet-portrait": {
        "width": {
          "$type": "dimension",
          "$value": "768px"
        },
        "height": {
          "$type": "dimension",
          "$value": "1024px"
        }
      },
      "laptop": {
        "width": {
          "$type": "dimension",
          "$value": "1280px"
        },
        "height": {
          "$type": "dimension",
          "$value": "800px"
        }
      },
      "desktop": {
        "width": {
          "$type": "dimension",
          "$value": "1920px"
        },
        "height": {
          "$type": "dimension",
          "$value": "1080px"
        }
      },
      "2k": {
        "width": {
          "$type": "dimension",
          "$value": "2560px"
        },
        "height": {
          "$type": "dimension",
          "$value": "1440px"
        }
      },
      "4k": {
        "width": {
          "$type": "dimension",
          "$value": "3840px"
        },
        "height": {
          "$type": "dimension",
          "$value": "2160px"
        }
      }
    },
    "space": {
      "px": {
        "$type": "dimension",
        "$value": "1px"
      },
      "xxs": {
        "$type": "dimension",
        "$value": "{grid.module} * 0.5"
      },
      "xs": {
        "$type": "dimension",
        "$value": "{grid.module}"
      },
      "sm": {
        "$type": "dimension",
        "$value": "{grid.module} * 2"
      },
      "md": {
        "$type": "dimension",
        "$value": "{grid.module} * 4"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{grid.module} * 8"
      }
    }
  },
  "light": {
    "color": {
      "background": {
        "$type": "color",
        "$value": "{color.white}"
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "brand": {
        "$type": "color",
        "$value": "{color.moss}"
      }
    }
  },
  "dark": {
    "color": {
      "background": {
        "$type": "color",
        "$value": "{color.night}"
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.white}"
      },
      "brand": {
        "$type": "color",
        "$value": "{color.moss}"
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "light",
      "selectedTokenSets": {
        "primitive": "enabled",
        "light": "enabled"
      }
    },
    {
      "id": "dark",
      "name": "dark",
      "selectedTokenSets": {
        "primitive": "enabled",
        "dark": "enabled"
      }
    }
  ],
  "$metadata": {
    "tokenSetOrder": ["primitive", "light", "dark"]
  }
}
